<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="SettingsMenu" src="project://database/Assets/_Project/Prefabs/UI/menus/SettingsMenu.uxml?fileID=9197481963319205126&amp;guid=4a29e62c0f2175f46ba53e25ac010e93&amp;type=3#SettingsMenu"/>
    <ui:VisualElement name="inGameGroup" style="flex-grow: 1;">
        <ui:VisualElement name="anachronismToolsGroup" style="position: absolute; left: 25%; top: 75%; width: 52%; height: 25%; flex-direction: row; justify-content: space-around;">
            <ui:Button text="grand" name="bigDisruptionButton" style="flex-direction: column-reverse;">
                <ui:ProgressBar value="0" title="grand" name="bigDisruptionBar"/>
            </ui:Button>
            <ui:Button text="petit" name="smallDisruptionButton" style="flex-direction: column-reverse;">
                <ui:ProgressBar value="0" title="petit" name="smallDisruptionBar"/>
            </ui:Button>
            <ui:Button text="moyen" name="mediumDisruptionButton" style="flex-direction: column-reverse;">
                <ui:ProgressBar value="0" title="moyen" name="mediumDisruptionBar"/>
            </ui:Button>
        </ui:VisualElement>
        <ui:ProgressBar value="0" title="" name="deregulationBar"/>
        <ui:Label text="" name="timer"/>
    </ui:VisualElement>
    <ui:VisualElement name="pauseMenuGroup" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; flex-direction: row;">
        <ui:GroupBox name="commands" style="width: 65%;">
            <ui:Label text="pause" style="align-self: center;"/>
            <ui:Button text="reprendre" name="resumeButton"/>
            <ui:Button text="options" name="settingsButton"/>
            <ui:Button text="quitter" name="quitButton"/>
        </ui:GroupBox>
        <ui:GroupBox name="controls">
            <ui:Image name="keyboard"/>
            <ui:Image name="mouse"/>
            <ui:Image name="specialActions"/>
        </ui:GroupBox>
    </ui:VisualElement>
    <ui:VisualElement name="popUpGroup" style="position: absolute; left: 30%; top: 17%; width: 45%; height: 61%;">
        <ui:Label text="que voulez-vous faire ?" style="align-self: center;"/>
        <ui:GroupBox style="flex-direction: row; justify-content: space-evenly;">
            <ui:Button text="menu principal" name="mainMenuButton"/>
            <ui:Button text="quitter" name="quitQuitButton"/>
            <ui:Button text="annuler" name="cancelButton"/>
        </ui:GroupBox>
    </ui:VisualElement>
    <ui:Instance template="SettingsMenu" name="settingsGroup" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;"/>
</ui:UXML>
