<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="LobbyMenu.uss" />
    <ui:VisualElement name="root" class="root" picking-mode="Ignore">

        <ui:VisualElement name="home-panel" class="panel">
            <ui:Label text="ANACHRO" class="title" />
            <ui:Label text="Trouve l'erreur… temporelle" class="subtitle" />
            <ui:DropdownField name="map-field" label="Carte" class="setting" />
            <ui:Button name="create-button" text="Créer une partie" class="button button--primary" />
            <ui:Label text="Rejoindre avec un code" class="caption" />
            <ui:VisualElement class="row">
                <ui:TextField name="code-field" max-length="9" class="code-field" />
                <ui:Button name="join-button" text="Rejoindre" class="button" />
            </ui:VisualElement>
            <ui:Label text="Tester sur ce PC (sans Steam)" class="caption" />
            <ui:VisualElement class="row">
                <ui:Button name="local-host-button" text="Héberger en local" class="button" />
                <ui:Button name="local-join-button" text="Rejoindre en local" class="button" />
            </ui:VisualElement>
            <ui:Label name="steam-warning" text="Steam n'est pas lancé : ferme le jeu, ouvre Steam, puis relance." class="warning" />
            <ui:Button name="quit-button" text="Quitter le jeu" class="button button--ghost" />
        </ui:VisualElement>

        <ui:VisualElement name="connecting-panel" class="panel">
            <ui:Label text="Connexion à la partie…" class="info" />
            <ui:Button name="cancel-button" text="Annuler" class="button button--ghost" />
        </ui:VisualElement>

        <ui:VisualElement name="lobby-panel" class="panel">
            <ui:Label text="Code de la partie" class="caption" />
            <ui:VisualElement class="row">
                <ui:Label name="lobby-code" text="----" class="code" />
                <ui:Button name="copy-button" text="Copier" class="button button--small" />
            </ui:VisualElement>
            <ui:Label name="player-count" class="info" />
            <ui:Label name="result-label" class="result" />
            <ui:VisualElement name="settings-panel" class="settings">
                <ui:Label text="Réglages de la partie" class="caption" />
                <ui:IntegerField name="villains-field" label="Fugitifs" class="setting" />
                <ui:IntegerField name="objects-field" label="Objets par fugitif" class="setting" />
                <ui:IntegerField name="scouting-field" label="Repérage (s)" class="setting" />
                <ui:IntegerField name="searching-field" label="Chasse (min, cachée aux joueurs)" class="setting" />
                <ui:IntegerField name="last-chance-field" label="Dernière chance (s)" class="setting" />
                <ui:Label name="settings-summary" class="info" />
            </ui:VisualElement>
            <ui:Button name="solo-role-button" text="Test solo : chasseur" class="button button--small" />
            <ui:Button name="start-button" text="Lancer la partie" class="button button--primary" />
            <ui:Label name="waiting-label" text="En attente de l'hôte…" class="info" />
            <ui:Button name="leave-button" text="Quitter la partie" class="button button--ghost" />
        </ui:VisualElement>

        <ui:VisualElement name="match-bar" class="match-bar" picking-mode="Ignore">
            <ui:Label name="match-phase" class="match-text" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:Label name="status-label" class="status" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
